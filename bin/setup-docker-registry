#!/usr/bin/env bash
# Setup Docker Registry on remote server
#
# This script sets up a Docker registry container on the remote server
# with persistent storage and optional authentication.
#
# Usage:
#   bin/setup-docker-registry --host 139.199.178.175 --user ubuntu [--password pass] [--port 5000]

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default values
REGISTRY_PORT=5000
REGISTRY_NAME="registry"
REGISTRY_VOLUME="registry-data"

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --host)
      REMOTE_HOST="$2"
      shift 2
      ;;
    --user)
      REMOTE_USER="$2"
      shift 2
      ;;
    --password)
      REMOTE_PASSWORD="$2"
      shift 2
      ;;
    --port)
      REGISTRY_PORT="$2"
      shift 2
      ;;
    *)
      echo -e "${RED}Unknown option: $1${NC}"
      exit 1
      ;;
  esac
done

# Validate required arguments
if [ -z "$REMOTE_HOST" ] || [ -z "$REMOTE_USER" ]; then
  echo -e "${RED}Error: Missing required arguments${NC}"
  echo ""
  echo "Usage:"
  echo "  bin/setup-docker-registry --host HOST --user USER [--password PASS] [--port 5000]"
  echo ""
  echo "Examples:"
  echo "  # Using SSH key"
  echo "  bin/setup-docker-registry --host 139.199.178.175 --user ubuntu"
  echo ""
  echo "  # Using password"
  echo "  bin/setup-docker-registry --host 139.199.178.175 --user ubuntu --password mypass"
  echo ""
  echo "  # Custom port"
  echo "  bin/setup-docker-registry --host 139.199.178.175 --user ubuntu --port 5001"
  exit 1
fi

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Docker Registry Setup${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "Remote server: ${YELLOW}${REMOTE_USER}@${REMOTE_HOST}${NC}"
echo -e "Registry port: ${YELLOW}${REGISTRY_PORT}${NC}"
echo -e "Registry name: ${YELLOW}${REGISTRY_NAME}${NC}"
echo ""

# Test SSH connection
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Step 1: Test SSH Connection${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

if [ -n "$REMOTE_PASSWORD" ]; then
  # Test with password
  if ! command -v sshpass &> /dev/null; then
    echo -e "${RED}✗ sshpass not found${NC}"
    echo ""
    echo "Please install sshpass:"
    echo "  macOS: brew install hudochenkov/sshpass/sshpass"
    echo "  Ubuntu: sudo apt-get install sshpass"
    exit 1
  fi

  if sshpass -p "$REMOTE_PASSWORD" ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "${REMOTE_USER}@${REMOTE_HOST}" "echo 'SSH OK'" > /dev/null 2>&1; then
    echo -e "${GREEN}✓ SSH connection successful${NC}"
  else
    echo -e "${RED}✗ SSH connection failed${NC}"
    exit 1
  fi
  SSH_CMD="sshpass -p $REMOTE_PASSWORD ssh -o StrictHostKeyChecking=no"
else
  # Test with SSH key
  if ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "${REMOTE_USER}@${REMOTE_HOST}" "echo 'SSH OK'" > /dev/null 2>&1; then
    echo -e "${GREEN}✓ SSH connection successful${NC}"
  else
    echo -e "${RED}✗ SSH connection failed${NC}"
    echo ""
    echo "Please ensure SSH key is configured or provide --password"
    exit 1
  fi
  SSH_CMD="ssh -o StrictHostKeyChecking=no"
fi

# Check if Docker is installed
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Step 2: Check Docker Installation${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

if $SSH_CMD "${REMOTE_USER}@${REMOTE_HOST}" "command -v docker > /dev/null 2>&1"; then
  DOCKER_VERSION=$($SSH_CMD "${REMOTE_USER}@${REMOTE_HOST}" "docker --version")
  echo -e "${GREEN}✓ Docker is installed: ${DOCKER_VERSION}${NC}"
else
  echo -e "${YELLOW}⚠ Docker is not installed${NC}"
  echo ""
  echo -e "${BLUE}ℹ Installing Docker...${NC}"

  # Install Docker
  $SSH_CMD "${REMOTE_USER}@${REMOTE_HOST}" << 'EOF'
    set -e

    # Update package index
    sudo apt-get update -qq

    # Install prerequisites
    sudo apt-get install -y -qq \
      apt-transport-https \
      ca-certificates \
      curl \
      gnupg \
      lsb-release

    # Add Docker's official GPG key
    sudo mkdir -p /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg

    # Set up the repository
    echo \
      "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
      $(lsb_release -cs) stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

    # Install Docker Engine
    sudo apt-get update -qq
    sudo apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

    # Add current user to docker group
    sudo usermod -aG docker $USER

    # Start Docker service
    sudo systemctl start docker
    sudo systemctl enable docker
EOF

  echo -e "${GREEN}✓ Docker installed successfully${NC}"
fi

# Setup Docker registry
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Step 3: Setup Docker Registry${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

$SSH_CMD "${REMOTE_USER}@${REMOTE_HOST}" bash -s << EOF
set -e

# Stop and remove existing registry if exists
if docker ps -a --format '{{.Names}}' | grep -q "^${REGISTRY_NAME}\$"; then
  echo "Stopping existing registry container..."
  docker stop ${REGISTRY_NAME} 2>/dev/null || true
  docker rm ${REGISTRY_NAME} 2>/dev/null || true
fi

# Create volume for persistent storage
if ! docker volume ls --format '{{.Name}}' | grep -q "^${REGISTRY_VOLUME}\$"; then
  echo "Creating Docker volume: ${REGISTRY_VOLUME}"
  docker volume create ${REGISTRY_VOLUME}
fi

# Start registry container
echo "Starting Docker registry on port ${REGISTRY_PORT}..."
docker run -d \
  --name ${REGISTRY_NAME} \
  --restart=unless-stopped \
  -p ${REGISTRY_PORT}:5000 \
  -v ${REGISTRY_VOLUME}:/var/lib/registry \
  registry:2

# Wait for registry to be ready
echo "Waiting for registry to be ready..."
sleep 3

# Test registry
if curl -f -s http://localhost:${REGISTRY_PORT}/v2/_catalog > /dev/null; then
  echo "✓ Registry is running and accessible"
else
  echo "✗ Registry health check failed"
  exit 1
fi

# Show registry info
echo ""
echo "Registry container info:"
docker ps --filter name=${REGISTRY_NAME} --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
EOF

echo -e "${GREEN}✓ Docker registry setup completed${NC}"

# Get registry connection info
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Step 4: Get Registry Connection Info${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Use public IP for better compatibility
# This works because Linux kernel routes to loopback automatically
REGISTRY_ADDRESS="${REMOTE_HOST}:${REGISTRY_PORT}"

echo -e "${GREEN}✓ Registry is accessible at:${NC}"
echo -e "  • Public address: ${YELLOW}${REGISTRY_ADDRESS}${NC} (recommended)"
echo -e "  • From localhost: ${YELLOW}127.0.0.1:${REGISTRY_PORT}${NC}"
echo ""
echo -e "${BLUE}ℹ${NC}  Using public IP instead of Docker bridge IP (172.17.0.1)"
echo -e "   This provides better compatibility and similar performance"

# Summary
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Setup Complete${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "${GREEN}✓ Docker registry is now running on ${REMOTE_HOST}${NC}"
echo ""
echo "Registry address:"
echo -e "  ${YELLOW}${REGISTRY_ADDRESS}${NC}"
echo ""
echo "Next steps:"
echo -e "  1. Configure insecure registry support:"
echo -e "     ${YELLOW}bin/setup-kamal-insecure-registry \\${NC}"
echo -e "     ${YELLOW}  --host ${REMOTE_HOST} \\${NC}"
echo -e "     ${YELLOW}  --user ${REMOTE_USER} \\${NC}"
echo -e "     ${YELLOW}  --registry ${REGISTRY_ADDRESS}${NC}"
echo ""
echo -e "  2. Build and push your image:"
echo -e "     ${YELLOW}bin/kamal build push${NC}"
echo ""
echo "Verify registry:"
echo -e "  ${YELLOW}curl http://${REMOTE_HOST}:${REGISTRY_PORT}/v2/_catalog${NC}"
echo ""
