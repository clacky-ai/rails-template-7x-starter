#!/usr/bin/env bash

# Kamal Insecure Registry 一键配置脚本
#
# 功能：
# 1. 配置 SSH 公钥到远程服务器
# 2. 测试 SSH 连接
# 3. 在远程服务器上创建 BuildKit 配置
# 4. 更新本地配置文件
# 5. 配置 builder
#
# 用法：
#   .kamal/scripts/setup-kamal-insecure-registry --host <HOST> --user <USER> [--password <PASSWORD>] --registry <REGISTRY>
#
# 示例：
#   .kamal/scripts/setup-kamal-insecure-registry --host 139.199.178.175 --user ubuntu --password mypass --registry 172.17.0.1:5000
#   .kamal/scripts/setup-kamal-insecure-registry --host 139.199.178.175 --user ubuntu --registry 172.17.0.1:5000

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 默认值
REMOTE_HOST=""
REMOTE_USER=""
REMOTE_PASSWORD=""
REGISTRY_SERVER=""
BUILDER_NAME="kamal-insecure-builder"
SSH_KEY_PATH="$HOME/.ssh/id_rsa"

# 打印函数
print_header() {
    echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  $1${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_error() {
    echo -e "${RED}✗ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

# 使用说明
usage() {
    cat << EOF
用法: $0 --host <HOST> --user <USER> [--password <PASSWORD>] --registry <REGISTRY>

必需参数:
  --host <HOST>           远程服务器 IP 地址
  --user <USER>           远程服务器用户名
  --registry <REGISTRY>   Registry 地址 (如: 172.17.0.1:5000)

可选参数:
  --password <PASSWORD>   远程服务器密码 (如果已配置 SSH 密钥则不需要)
  --builder-name <NAME>   Builder 名称 (默认: kamal-insecure-builder)
  --ssh-key <PATH>        SSH 密钥路径 (默认: ~/.ssh/id_rsa)
  -h, --help             显示此帮助信息

示例:
  # 使用密码配置
  $0 --host 139.199.178.175 --user ubuntu --password mypass --registry 172.17.0.1:5000

  # 使用现有 SSH 密钥
  $0 --host 139.199.178.175 --user ubuntu --registry 172.17.0.1:5000

EOF
    exit 1
}

# 解析命令行参数
while [[ $# -gt 0 ]]; do
    case $1 in
        --host)
            REMOTE_HOST="$2"
            shift 2
            ;;
        --user)
            REMOTE_USER="$2"
            shift 2
            ;;
        --password)
            REMOTE_PASSWORD="$2"
            shift 2
            ;;
        --registry)
            REGISTRY_SERVER="$2"
            shift 2
            ;;
        --builder-name)
            BUILDER_NAME="$2"
            shift 2
            ;;
        --ssh-key)
            SSH_KEY_PATH="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            print_error "未知参数: $1"
            usage
            ;;
    esac
done

# 验证必需参数
if [ -z "$REMOTE_HOST" ] || [ -z "$REMOTE_USER" ] || [ -z "$REGISTRY_SERVER" ]; then
    print_error "缺少必需参数"
    usage
fi

# 显示配置信息
print_header "配置信息"
echo "远程服务器: ${REMOTE_USER}@${REMOTE_HOST}"
echo "Registry 地址: ${REGISTRY_SERVER}"
echo "Builder 名称: ${BUILDER_NAME}"
echo "SSH 密钥路径: ${SSH_KEY_PATH}"
echo ""

# 检查是否需要安装 sshpass
if [ -n "$REMOTE_PASSWORD" ]; then
    if ! command -v sshpass &> /dev/null; then
        print_warning "需要安装 sshpass 来使用密码认证"
        print_info "macOS: brew install hudochenkov/sshpass/sshpass"
        print_info "Ubuntu: sudo apt-get install sshpass"
        exit 1
    fi
fi

# Step 1: 生成 SSH 密钥（如果不存在）
print_header "Step 1: 检查 SSH 密钥"
if [ ! -f "$SSH_KEY_PATH" ]; then
    print_info "生成新的 SSH 密钥..."
    ssh-keygen -t rsa -b 4096 -f "$SSH_KEY_PATH" -N "" -C "kamal-deployment"
    print_success "SSH 密钥已生成: $SSH_KEY_PATH"
else
    print_success "SSH 密钥已存在: $SSH_KEY_PATH"
fi

# Step 2: 配置 SSH 公钥到远程服务器
print_header "Step 2: 配置 SSH 公钥"

SSH_CMD_PREFIX=""
if [ -n "$REMOTE_PASSWORD" ]; then
    SSH_CMD_PREFIX="sshpass -p '$REMOTE_PASSWORD'"
    print_info "使用密码认证配置 SSH 公钥..."
else
    print_info "使用现有 SSH 密钥..."
fi

# 复制公钥到远程服务器
if [ -n "$REMOTE_PASSWORD" ]; then
    eval "$SSH_CMD_PREFIX ssh-copy-id -o StrictHostKeyChecking=no -i '$SSH_KEY_PATH.pub' '${REMOTE_USER}@${REMOTE_HOST}'" 2>/dev/null || {
        print_warning "ssh-copy-id 失败，尝试手动复制..."
        PUBLIC_KEY=$(cat "${SSH_KEY_PATH}.pub")
        eval "$SSH_CMD_PREFIX ssh -o StrictHostKeyChecking=no '${REMOTE_USER}@${REMOTE_HOST}' \"mkdir -p ~/.ssh && chmod 700 ~/.ssh && echo '$PUBLIC_KEY' >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys\"" || {
            print_error "无法配置 SSH 公钥"
            exit 1
        }
    }
    print_success "SSH 公钥已配置"
else
    print_info "跳过公钥配置（假设已配置）"
fi

# Step 3: 测试 SSH 连接
print_header "Step 3: 测试 SSH 连接"
if ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "${REMOTE_USER}@${REMOTE_HOST}" "echo 'SSH 连接成功'" &> /dev/null; then
    print_success "SSH 连接测试成功"
else
    print_error "SSH 连接失败"
    exit 1
fi

# Step 4: 在远程服务器上创建 BuildKit 配置
print_header "Step 4: 配置远程服务器 BuildKit"

print_info "创建 BuildKit 配置文件..."
ssh "${REMOTE_USER}@${REMOTE_HOST}" << EOF
    set -e

    # 创建配置目录
    sudo mkdir -p /etc/buildkit

    # 创建配置文件
    sudo tee /etc/buildkit/buildkitd.toml > /dev/null << 'BUILDKIT_CONFIG'
[registry."${REGISTRY_SERVER}"]
  http = true
  insecure = true
BUILDKIT_CONFIG

    # 验证配置文件
    echo "BuildKit 配置文件内容："
    sudo cat /etc/buildkit/buildkitd.toml
EOF

print_success "BuildKit 配置已创建"

# Step 5: 更新本地 config/deploy.yml
print_header "Step 5: 更新本地配置文件"

DEPLOY_CONFIG="config/deploy.yml"
if [ ! -f "$DEPLOY_CONFIG" ]; then
    print_error "配置文件不存在: $DEPLOY_CONFIG"
    exit 1
fi

print_info "备份原配置文件..."
cp "$DEPLOY_CONFIG" "${DEPLOY_CONFIG}.backup.$(date +%Y%m%d_%H%M%S)"
print_success "备份已保存"

print_info "更新 registry 配置..."
# 使用 ruby 来更新 YAML 配置
ruby << RUBY_SCRIPT
require 'yaml'

config_file = '$DEPLOY_CONFIG'
config = YAML.load_file(config_file)

# 更新 registry 配置
config['registry'] = {
  'server' => '$REGISTRY_SERVER',
  'username' => 'noauth',
  'password' => 'noauth'
}

# 更新 builder 配置
config['builder'] ||= {}
config['builder']['remote'] = "ssh://${REMOTE_USER}@${REMOTE_HOST}"
config['builder']['name'] = '$BUILDER_NAME'
config['builder']['local'] = false

# 保存配置
File.write(config_file, YAML.dump(config))
puts "✓ 配置已更新"
RUBY_SCRIPT

print_success "配置文件已更新"

# Step 6: 更新 recreate-buildkit-container.sh 脚本
print_header "Step 6: 更新辅助脚本"

RECREATE_SCRIPT=".kamal/scripts/recreate-buildkit-container.sh"
print_info "更新 BuildKit 容器重建脚本..."

cat > "$RECREATE_SCRIPT" << 'EOF'
#!/usr/bin/env bash

# Helper script to recreate BuildKit container with insecure registry config
#
# This script recreates the BuildKit container after `kamal build create`
# and mounts the /etc/buildkit/buildkitd.toml file from the remote host.
#
# Usage:
#   .kamal/scripts/recreate-buildkit-container.sh
#
# Prerequisite:
#   - /etc/buildkit/buildkitd.toml must exist on remote host
#   - Builder must be created with `kamal build create` first

set -e

# Read configuration from config/deploy.yml
BUILDER_NAME=$(ruby -ryaml -e "puts YAML.load_file('config/deploy.yml')['builder']['name']")
REMOTE_SSH=$(ruby -ryaml -e "puts YAML.load_file('config/deploy.yml')['builder']['remote']")

# Extract user@host from SSH URL
REMOTE_HOST=$(echo "$REMOTE_SSH" | sed 's|ssh://||')

echo "======================================"
echo "Recreating BuildKit container"
echo "======================================"
echo ""
echo "Builder name: $BUILDER_NAME"
echo "Remote host: $REMOTE_HOST"
echo ""

# Recreate the BuildKit container with config file mounted
ssh "$REMOTE_HOST" << 'REMOTE_EOF'
  set -e

  CONTAINER_NAME="buildx_buildkit_${BUILDER_NAME}0"
  VOLUME_NAME="buildx_buildkit_${BUILDER_NAME}0_state"

  echo "Stopping and removing $CONTAINER_NAME..."
  docker stop $CONTAINER_NAME 2>/dev/null || true
  docker rm $CONTAINER_NAME 2>/dev/null || true

  echo "Creating new BuildKit container with config mounted..."
  docker run -d \
    --name $CONTAINER_NAME \
    --restart unless-stopped \
    --net host \
    --privileged \
    -v /etc/buildkit/buildkitd.toml:/etc/buildkit/buildkitd.toml:ro \
    -v $VOLUME_NAME:/var/lib/buildkit \
    moby/buildkit:buildx-stable-1 \
    --config /etc/buildkit/buildkitd.toml \
    --allow-insecure-entitlement=network.host

  echo ""
  echo "Verifying config file in container..."
  docker exec $CONTAINER_NAME cat /etc/buildkit/buildkitd.toml
  echo ""
  echo "BuildKit container ready!"
REMOTE_EOF

echo ""
echo "======================================"
echo "BuildKit container recreated successfully!"
echo "======================================"
echo ""
echo "You can now run: bin/kamal build push"
EOF

chmod +x "$RECREATE_SCRIPT"
print_success "脚本已更新: $RECREATE_SCRIPT"

# Step 7: 创建 builder
print_header "Step 7: 创建 Kamal Builder"

print_info "创建 builder..."
if bin/kamal build create 2>&1; then
    print_success "Builder 创建成功"
else
    print_warning "Builder 可能已存在，继续..."
fi

print_info "重新创建 BuildKit 容器..."
if "$RECREATE_SCRIPT" 2>&1; then
    print_success "BuildKit 容器配置完成"
else
    print_error "BuildKit 容器配置失败"
    exit 1
fi

# 完成
print_header "配置完成"
print_success "所有配置已完成！"
echo ""
echo "配置摘要："
echo "  • SSH 连接: ${REMOTE_USER}@${REMOTE_HOST}"
echo "  • Registry: ${REGISTRY_SERVER}"
echo "  • Builder: ${BUILDER_NAME}"
echo ""
echo "下一步操作："
echo "  1. 构建并推送镜像:"
echo "     ${GREEN}bin/kamal build push${NC}"
echo ""
echo "  2. 完整部署:"
echo "     ${GREEN}bin/kamal deploy${NC}"
echo ""
echo "备注："
echo "  • 原配置已备份到: ${DEPLOY_CONFIG}.backup.*"
echo "  • 如需重新配置 BuildKit 容器，运行:"
echo "    ${BLUE}.kamal/scripts/recreate-buildkit-container.sh${NC}"
echo ""
