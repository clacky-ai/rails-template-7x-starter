#!/usr/bin/env bash
# Setup Docker Registry on remote server
#
# This script sets up a Docker registry container on the remote server
# with persistent storage and optional authentication.
#
# Usage:
#   .kamal/scripts/setup-docker-registry --host 139.199.178.175 --user ubuntu [--password pass] [--port 5000]

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default values
REGISTRY_PORT=5000
REGISTRY_NAME="registry"
REGISTRY_VOLUME="registry-data"

# Function to install Docker (Ubuntu/Debian)
install_docker() {
  # Update package index
  sudo apt-get update -qq

  # Install prerequisites
  sudo apt-get install -y -qq \
    apt-transport-https \
    ca-certificates \
    curl \
    gnupg \
    lsb-release

  # Add Docker's official GPG key
  sudo mkdir -p /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg

  # Set up the repository
  echo \
    "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
    $(lsb_release -cs) stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

  # Install Docker Engine
  sudo apt-get update -qq
  sudo apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

  # Add current user to docker group
  sudo usermod -aG docker $USER

  # Start Docker service
  sudo systemctl start docker
  sudo systemctl enable docker
}

# Function to check and setup Docker
check_and_setup_docker() {
  if command -v docker > /dev/null 2>&1; then
    DOCKER_VERSION=$(docker --version)
    echo -e "${GREEN}✓ Docker is installed: ${DOCKER_VERSION}${NC}"

    # Check if Docker daemon is running
    if docker info > /dev/null 2>&1; then
      echo -e "${GREEN}✓ Docker daemon is running${NC}"
    else
      echo -e "${YELLOW}⚠ Docker daemon is not running${NC}"
      echo ""
      echo -e "${BLUE}ℹ Starting Docker daemon...${NC}"

      # Try to start Docker daemon
      if sudo systemctl start docker 2>/dev/null; then
        echo -e "${GREEN}✓ Docker daemon started successfully${NC}"
      else
        echo -e "${RED}✗ Failed to start Docker daemon${NC}"
        echo ""
        echo "Please start Docker manually:"
        echo "  - macOS: Start Docker Desktop"
        echo "  - Linux: sudo systemctl start docker"
        exit 1
      fi
    fi
  else
    echo -e "${YELLOW}⚠ Docker is not installed${NC}"
    echo ""
    echo -e "${BLUE}ℹ Installing Docker...${NC}"

    # Install Docker using the shared function
    install_docker

    echo -e "${GREEN}✓ Docker installed successfully${NC}"

    # Verify installation
    if docker info > /dev/null 2>&1; then
      echo -e "${GREEN}✓ Docker daemon is running${NC}"
    else
      echo -e "${YELLOW}⚠ Docker installed but daemon not running. You may need to log out and back in.${NC}"
    fi
  fi
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --host)
      REMOTE_HOST="$2"
      shift 2
      ;;
    --user)
      REMOTE_USER="$2"
      shift 2
      ;;
    --password)
      REMOTE_PASSWORD="$2"
      shift 2
      ;;
    --port)
      REGISTRY_PORT="$2"
      shift 2
      ;;
    *)
      echo -e "${RED}Unknown option: $1${NC}"
      exit 1
      ;;
  esac
done

# Validate required arguments
if [ -z "$REMOTE_HOST" ] || [ -z "$REMOTE_USER" ]; then
  echo -e "${RED}Error: Missing required arguments${NC}"
  echo ""
  echo "Usage:"
  echo "  .kamal/scripts/setup-docker-registry --host HOST --user USER [--password PASS] [--port 5000]"
  echo ""
  echo "Examples:"
  echo "  # Using SSH key"
  echo "  .kamal/scripts/setup-docker-registry --host 139.199.178.175 --user ubuntu"
  echo ""
  echo "  # Using password"
  echo "  .kamal/scripts/setup-docker-registry --host 139.199.178.175 --user ubuntu --password mypass"
  echo ""
  echo "  # Custom port"
  echo "  .kamal/scripts/setup-docker-registry --host 139.199.178.175 --user ubuntu --port 5001"
  exit 1
fi

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Docker Registry Setup${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "Remote server: ${YELLOW}${REMOTE_USER}@${REMOTE_HOST}${NC}"
echo -e "Registry port: ${YELLOW}${REGISTRY_PORT}${NC}"
echo -e "Registry name: ${YELLOW}${REGISTRY_NAME}${NC}"
echo ""

# Step 1: Check local Docker installation (required for Kamal)
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Step 1: Check Local Docker Installation${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

check_and_setup_docker

# Step 2: Check remote Docker installation
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Step 2: Check Remote Docker Installation${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Export functions and execute remotely
$SSH_CMD "${REMOTE_USER}@${REMOTE_HOST}" "
  # Color definitions
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  BLUE='\033[0;34m'
  RED='\033[0;31m'
  NC='\033[0m'

  $(declare -f install_docker)
  $(declare -f check_and_setup_docker)
  check_and_setup_docker
"

# Configure Docker registry mirror
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Step 3: Configure Docker Registry Mirror${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

echo -e "${BLUE}ℹ Testing registry mirrors to find the fastest...${NC}"

$SSH_CMD "${REMOTE_USER}@${REMOTE_HOST}" bash << 'REMOTE_EOF'
# Colors for remote output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Registry mirrors to test
MIRRORS=(
  "https://registry-1.docker.io|Docker Hub Direct"
  "https://mirror.ccs.tencentyun.com|Tencent Cloud"
  "https://dockerproxy.com|DockerProxy"
  "https://docker.mirrors.ustc.edu.cn|USTC"
  "https://hub-mirror.c.163.com|NetEase"
)

# Function to test registry speed
test_registry_speed() {
  local url="$1"
  local name="$2"

  # Test with timeout of 3 seconds
  local start_time=$(date +%s%N)
  if curl -s -m 3 -o /dev/null -w "%{http_code}" "${url}/v2/" 2>/dev/null | grep -q "200\|401"; then
    local end_time=$(date +%s%N)
    local elapsed=$(( (end_time - start_time) / 1000000 )) # Convert to milliseconds
    echo "${elapsed}|${url}|${name}"
    return 0
  else
    echo "9999|${url}|${name}"
    return 1
  fi
}

echo "Testing registry mirrors..."
echo ""

fastest_time=9999
fastest_url=""
fastest_name=""

# Test all mirrors
for mirror_info in "${MIRRORS[@]}"; do
  IFS='|' read -r url name <<< "$mirror_info"

  echo -ne "  Testing ${name}... "

  result=$(test_registry_speed "$url" "$name")
  IFS='|' read -r time test_url test_name <<< "$result"

  if [ "$time" -lt "$fastest_time" ]; then
    fastest_time=$time
    fastest_url=$test_url
    fastest_name=$test_name
  fi

  if [ "$time" -eq 9999 ]; then
    echo -e "${RED}✗ Failed${NC}"
  else
    echo -e "${GREEN}✓ ${time}ms${NC}"
  fi
done

echo ""

# Check if we found any working mirror
if [ "$fastest_time" -eq 9999 ]; then
  echo -e "${YELLOW}⚠ All registry mirrors failed, using default configuration${NC}"
  echo ""
  echo "Configuring Docker daemon with insecure registry support..."

  # Create Docker config directory
  sudo mkdir -p /etc/docker

  # Create daemon.json with only insecure-registries
  sudo tee /etc/docker/daemon.json > /dev/null <<DAEMON_JSON
{
  "insecure-registries": ["172.17.0.1:5000"]
}
DAEMON_JSON

  echo -e "${GREEN}✓ Docker daemon configuration updated${NC}"

  # Reload Docker daemon
  sudo systemctl daemon-reload 2>/dev/null || true
  sudo systemctl restart docker 2>/dev/null || sudo service docker restart 2>/dev/null || true

  # Wait for Docker to be ready
  echo "Waiting for Docker to be ready..."
  sleep 3

  # Verify Docker is running
  if docker info > /dev/null 2>&1; then
    echo -e "${GREEN}✓ Docker daemon restarted successfully${NC}"
  else
    echo -e "${YELLOW}⚠ Docker daemon may need manual restart${NC}"
  fi
elif [[ "$fastest_url" == "https://registry-1.docker.io" ]]; then
  echo -e "${GREEN}✓ Fastest mirror: ${fastest_name} (${fastest_time}ms)${NC}"
  echo -e "${GREEN}✓ Docker Hub direct connection is fastest, no mirror needed${NC}"
  echo ""
  echo "Configuring Docker daemon with insecure registry support..."

  # Create Docker config directory
  sudo mkdir -p /etc/docker

  # Create daemon.json with only insecure-registries
  sudo tee /etc/docker/daemon.json > /dev/null <<DAEMON_JSON
{
  "insecure-registries": ["172.17.0.1:5000"]
}
DAEMON_JSON

  echo -e "${GREEN}✓ Docker daemon configuration updated${NC}"

  # Reload Docker daemon
  sudo systemctl daemon-reload 2>/dev/null || true
  sudo systemctl restart docker 2>/dev/null || sudo service docker restart 2>/dev/null || true

  # Wait for Docker to be ready
  echo "Waiting for Docker to be ready..."
  sleep 3

  # Verify Docker is running
  if docker info > /dev/null 2>&1; then
    echo -e "${GREEN}✓ Docker daemon restarted successfully${NC}"
  else
    echo -e "${YELLOW}⚠ Docker daemon may need manual restart${NC}"
  fi
else
  # Configure Docker daemon with the fastest mirror and insecure-registries
  echo -e "${GREEN}✓ Fastest mirror: ${fastest_name} (${fastest_time}ms)${NC}"
  echo ""
  echo "Configuring Docker daemon with mirror and insecure registry support..."

  # Create Docker config directory
  sudo mkdir -p /etc/docker

  # Create or update daemon.json with both mirror and insecure-registries
  sudo tee /etc/docker/daemon.json > /dev/null <<DAEMON_JSON
{
  "registry-mirrors": ["$fastest_url"],
  "insecure-registries": ["172.17.0.1:5000"]
}
DAEMON_JSON

  echo -e "${GREEN}✓ Docker daemon configuration updated${NC}"

  # Reload Docker daemon
  sudo systemctl daemon-reload 2>/dev/null || true
  sudo systemctl restart docker 2>/dev/null || sudo service docker restart 2>/dev/null || true

  # Wait for Docker to be ready
  echo "Waiting for Docker to be ready..."
  sleep 3

  # Verify Docker is running
  if docker info > /dev/null 2>&1; then
    echo -e "${GREEN}✓ Docker daemon reloaded successfully${NC}"
    echo ""
    echo "Registry mirror configured: $fastest_url"
    echo "Insecure registry configured: 172.17.0.1:5000"
  else
    echo -e "${YELLOW}⚠ Docker daemon may need manual restart${NC}"
  fi
fi
REMOTE_EOF

# Setup Docker registry
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Step 4: Setup Docker Registry${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

$SSH_CMD "${REMOTE_USER}@${REMOTE_HOST}" bash -s << EOF
set -e

# Stop and remove existing registry if exists
if docker ps -a --format '{{.Names}}' | grep -q "^${REGISTRY_NAME}\$"; then
  echo "Stopping existing registry container..."
  docker stop ${REGISTRY_NAME} 2>/dev/null || true
  docker rm ${REGISTRY_NAME} 2>/dev/null || true
fi

# Create volume for persistent storage
if ! docker volume ls --format '{{.Name}}' | grep -q "^${REGISTRY_VOLUME}\$"; then
  echo "Creating Docker volume: ${REGISTRY_VOLUME}"
  docker volume create ${REGISTRY_VOLUME}
fi

# Start registry container
echo "Starting Docker registry on port ${REGISTRY_PORT}..."
docker run -d \
  --name ${REGISTRY_NAME} \
  --restart=unless-stopped \
  -p ${REGISTRY_PORT}:5000 \
  -v ${REGISTRY_VOLUME}:/var/lib/registry \
  registry:3

# Wait for registry to be ready
echo "Waiting for registry to be ready..."
sleep 3

# Test registry
if curl -f -s http://localhost:${REGISTRY_PORT}/v2/_catalog > /dev/null; then
  echo "✓ Registry is running and accessible"
else
  echo "✗ Registry health check failed"
  exit 1
fi

# Show registry info
echo ""
echo "Registry container info:"
docker ps --filter name=${REGISTRY_NAME} --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
EOF

echo -e "${GREEN}✓ Docker registry setup completed${NC}"

# Get registry connection info
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Step 5: Get Registry Connection Info${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Detect actual Docker bridge IP
BRIDGE_IP=$($SSH_CMD "${REMOTE_USER}@${REMOTE_HOST}" "docker network inspect bridge --format '{{(index .IPAM.Config 0).Gateway}}' 2>/dev/null || echo '172.17.0.1'")

REGISTRY_ADDRESS_PUBLIC="${REMOTE_HOST}:${REGISTRY_PORT}"
REGISTRY_ADDRESS_BRIDGE="${BRIDGE_IP}:${REGISTRY_PORT}"

echo -e "${GREEN}✓ Registry is accessible at:${NC}"
echo ""
echo -e "${YELLOW}Single-server deployment (recommended):${NC}"
echo -e "  ${YELLOW}${REGISTRY_ADDRESS_BRIDGE}${NC}"
echo -e "  • All traffic stays local"
echo -e "  • Fastest performance"
echo -e "  • No network routing overhead"
if [ "$BRIDGE_IP" != "172.17.0.1" ]; then
  echo -e "  ${BLUE}ℹ${NC}  Detected non-default bridge IP: ${BRIDGE_IP}"
fi
echo ""
echo -e "${YELLOW}Multi-server deployment:${NC}"
echo -e "  ${YELLOW}${REGISTRY_ADDRESS_PUBLIC}${NC}"
echo -e "  • Accessible from other servers"
echo -e "  • May be slower due to NAT routing on cloud servers"
echo ""
echo -e "${BLUE}ℹ${NC}  Why Docker bridge IP for single server?"
echo -e "   Cloud servers use NAT for public IPs. Accessing your own public IP"
echo -e "   routes traffic through the gateway instead of loopback, causing"
echo -e "   Docker pull to take 2-3 minutes. Bridge IP keeps traffic local."

# Summary
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Setup Complete${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "${GREEN}✓ Docker registry is now running on ${REMOTE_HOST}${NC}"
echo ""
echo "Choose registry address based on your deployment:"
echo ""
echo -e "${YELLOW}For single-server deployment (recommended):${NC}"
echo -e "  Registry address: ${YELLOW}${REGISTRY_ADDRESS_BRIDGE}${NC}"
echo ""
echo -e "${YELLOW}For multi-server deployment:${NC}"
echo -e "  Registry address: ${YELLOW}${REGISTRY_ADDRESS_PUBLIC}${NC}"
echo ""
echo "Next steps:"
echo -e "  1. Configure insecure registry support:"
echo -e "     ${YELLOW}.kamal/scripts/setup-kamal-insecure-registry \\${NC}"
echo -e "     ${YELLOW}  --host ${REMOTE_HOST} \\${NC}"
echo -e "     ${YELLOW}  --user ${REMOTE_USER} \\${NC}"
echo -e "     ${YELLOW}  --registry <REGISTRY_ADDRESS>${NC}"
echo ""
echo -e "  2. Build and push your image:"
echo -e "     ${YELLOW}kamal build push${NC}"
echo ""
echo "Verify registry:"
echo -e "  ${YELLOW}curl http://${REGISTRY_ADDRESS_BRIDGE}/v2/_catalog${NC}"
echo ""
