#!/usr/bin/env ruby
# frozen_string_literal: true
# Kamal hook: pre-connect
# Lightweight SSH connection check before deployment

require 'yaml'

class PreConnectCheck
  DEPLOY_YML = 'config/deploy.yml'
  SETUP_MARKER = '.kamal/ssh_setup_done'
  
  def initialize
    @project_root = File.expand_path('../..', __dir__)
    Dir.chdir(@project_root)
  end

  def run
    # Only check if KAMAL_HOSTS is set (indicates we're in a Kamal operation)
    return unless ENV['KAMAL_HOSTS']

    # Quick connection test
    config = load_deploy_config
    ssh_user = config.dig('ssh', 'user') || 'root'
    
    # Get the host we're connecting to
    host = ENV['KAMAL_HOSTS']
    
    # Quick test with 1 second timeout
    unless test_ssh_connection(host, ssh_user)
      handle_connection_failure(host)
    end
  end

  private

  def load_deploy_config
    return {} unless File.exist?(DEPLOY_YML)
    
    begin
      YAML.safe_load_file(DEPLOY_YML) || {}
    rescue
      {}
    end
  end

  def test_ssh_connection(host, user)
    # Quick connection test with 1 second timeout
    cmd = "ssh -o BatchMode=yes -o ConnectTimeout=1 -o StrictHostKeyChecking=no #{user}@#{host} 'exit' 2>/dev/null"
    system(cmd)
  end

  def handle_connection_failure(host)
    puts "\n⚠️  SSH Connection Failed"
    puts "=" * 60
    puts "Cannot connect to #{host}"
    puts ""

    if File.exist?(SETUP_MARKER)
      # Setup was done before but now failing
      puts "🔍 Previous SSH setup marker found, but connection failed."
      puts "💡 Possible issues:"
      puts "   • SSH key was removed from server"
      puts "   • Server was reinstalled/reset"
      puts "   • Network connectivity issues"
      puts ""
      puts "🔧 Try running: #{colorize('bin/kamal_ssh_setup', :yellow)}"
    else
      # First time or setup never completed
      puts "🔐 SSH keys are not set up for this server."
      puts ""
      puts "🔧 Please run: #{colorize('bin/kamal_ssh_setup', :yellow)}"
      puts "   This will:"
      puts "   • Check/generate SSH keys"
      puts "   • Test connections to all servers"
      puts "   • Inject public keys where needed"
    end

    puts "=" * 60
    puts ""

    # Don't exit - let Kamal handle it and show its error message
    # This is just a helpful hint
  end

  def colorize(text, color)
    colors = {
      yellow: 33,
      red: 31
    }
    "\e[#{colors[color]}m#{text}\e[0m"
  end
end

# Run the check
PreConnectCheck.new.run if __FILE__ == $PROGRAM_NAME

